# Copy to .env and set for your machine. Every script reads these.
MODELS_DIR=/path/to/models          # where the GGUFs and the source checkpoint live
LLAMA_FORK=/path/to/llama.cpp-pr27739   # JJJYmmm fork @ dfa0c0f + patches/ (quantize + serve script)
LLAMA_TOOLS=/path/to/llama.cpp          # upstream @ 6c84c7d5 or later (convert + serve)
WORKDIR=/path/to/workdir            # logs and intermediates
